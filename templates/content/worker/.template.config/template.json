{
  "$schema": "http://json.schemastore.org/template",
  "author": "WorkThrough contributors",
  "classifications": ["Worker", "Background jobs"],
  "identity": "WorkThrough.Templates.Worker",
  "name": "WorkThrough worker",
  "description": "A background worker that runs durable jobs and a recurring schedule from a database.",
  "shortName": "workthrough-worker",
  "sourceName": "WorkThroughWorker",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "storage": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "postgresql",
      "description": "The database that stores jobs.",
      "choices": [
        { "choice": "postgresql", "description": "PostgreSQL; several machines." },
        { "choice": "sqlserver", "description": "SQL Server; several machines." },
        { "choice": "oracle", "description": "Oracle; several machines." },
        { "choice": "mysql", "description": "MySQL or MariaDB; several machines." }
      ]
    },
    "WorkThroughVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "1.0.0-rc.2",
      "replaces": "WORKTHROUGH_VERSION",
      "description": "The WorkThrough package version."
    },
    "UsePostgreSql": { "type": "computed", "value": "(storage == \"postgresql\")" },
    "UseSqlServer": { "type": "computed", "value": "(storage == \"sqlserver\")" },
    "UseOracle": { "type": "computed", "value": "(storage == \"oracle\")" },
    "UseMySql": { "type": "computed", "value": "(storage == \"mysql\")" }
  },
  "primaryOutputs": [{ "path": "WorkThroughWorker.csproj" }]
}
