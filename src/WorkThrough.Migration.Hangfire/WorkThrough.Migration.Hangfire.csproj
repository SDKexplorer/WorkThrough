<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Moves recurring, enqueued and scheduled Hangfire jobs into WorkThrough.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkThrough.Core/WorkThrough.Core.csproj" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <!-- Hangfire.Core accepts Newtonsoft.Json 11.0.1, which has a known vulnerability; consumers get a patched version. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
