<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Version>1.0.0-rc.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>WorkThrough contributors</Authors>
    <Product>WorkThrough.NET</Product>
    <!-- The name shown on nuget.org; package IDs stay WorkThrough.*, as Quartz.NET ships as Quartz. -->
    <Title>$(MSBuildProjectName.Replace('WorkThrough', 'WorkThrough.NET'))</Title>
    <Description>Durable background jobs, flows and schedules for .NET, stored in PostgreSQL, SQL Server, Oracle, MySQL or MariaDB.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 WorkThrough contributors</Copyright>
    <PackageProjectUrl>https://github.com/SDKexplorer/WorkThrough</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SDKexplorer/WorkThrough</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>background-jobs;jobs;workflow;scheduler;durable;queue</PackageTags>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
