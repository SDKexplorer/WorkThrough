<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Version>0.1.0-alpha.1</Version>
    <Authors>WorkThrough contributors</Authors>
    <Description>Contract-based durable background jobs for .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 WorkThrough contributors</Copyright>
    <PackageProjectUrl>https://github.com/SDKexplorer/WorkThrough</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SDKexplorer/WorkThrough</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>background-jobs;jobs;workflow;scheduler;durable;queue</PackageTags>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
